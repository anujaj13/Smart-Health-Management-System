# Multi-stage Dockerfile for HealthLink
# Optimized for Google Cloud Run deployment using uv
# FIXED: Now respects Cloud Run's PORT environment variable

# --- Stage 1: Build & Dependency Installation ---
FROM python:3.12-slim AS builder

# Install uv binary by copying it from the official image
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Set uv specific environment variables
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

# Copy lockfiles first to maximize Docker layer caching
COPY pyproject.toml uv.lock ./

# Install dependencies into a localized virtual environment (.venv)
# --no-install-project skips installing the current package code, focusing only on deps
RUN uv sync --frozen --no-install-project --no-dev --only-group=api


# --- Stage 2: Final Runtime Image ---
FROM python:3.12-slim

# Set runtime environment variables
# IMPORTANT: Do NOT hardcode PORT - Cloud Run will set it at runtime
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH" \
    PORT=8080

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy the pre-built virtual environment from the builder stage
COPY --from=builder /app/.venv /app/.venv

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p /app/data /app/logs

# Create non-root user for production security
RUN useradd -m -u 1000 healthlink && \
    chown -R healthlink:healthlink /app
USER healthlink

# Expose port (Cloud Run will override this, but good practice)
EXPOSE 8080

# Health check (updated to use PORT variable)
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8080}/api/v1/health || exit 1

# FIXED: Use $PORT environment variable instead of hardcoded port
# This allows Cloud Run to inject PORT=8080 (or any other port)
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8080} --workers 1"]